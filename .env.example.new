# ==================================
# AI Model Configuration
# ==================================

# Hugging Face (for GPT-OSS)
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_MODEL=openai/gpt-oss-120b

# OpenAI (for Whisper STT)
OPENAI_API_KEY=your_openai_api_key_here

# 11Labs (for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice (default)

# ==================================
# Infobip Configuration (WhatsApp + SMS)
# ==================================
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_WHATSAPP_NUMBER=447123456789  # Your Infobip WhatsApp sender number
INFOBIP_SMS_SENDER=HeySalad  # SMS sender name/number

# ==================================
# Slack Configuration
# ==================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here  # For socket mode

# ==================================
# Asterisk/SIP Configuration
# ==================================
ASTERISK_AGI_PATH=/var/lib/asterisk/agi-bin
ASTERISK_RECORDING_PATH=/var/spool/asterisk/recording
SIP_CONTEXT=voice-agent
SIP_EXTENSION=1000

# ==================================
# Application Configuration
# ==================================
PORT=8000
HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO

# ==================================
# Database Configuration
# ==================================
CHROMA_PERSIST_DIRECTORY=./chroma_db
UPLOAD_DIRECTORY=./uploads
USER_DATA_DIRECTORY=./user_data
LOG_DIRECTORY=./logs

# ==================================
# Security
# ==================================
API_KEY=your_api_key_here  # Optional: API key for REST endpoints
WEBHOOK_SECRET=your_webhook_secret_here  # For validating webhooks

# ==================================
# Features
# ==================================
ENABLE_VOICE=true
ENABLE_WHATSAPP=true
ENABLE_SMS=true
ENABLE_SLACK=true
ENABLE_WEB_RESEARCH=true
